[Unit]
Description=Telegram Workout Tracker Bot
# Wait for real network connectivity, not just the network stack, so the
# first Telegram connection after a reboot doesn't fail.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change to the Linux user/group running the bot (e.g. ubuntu)
User=ubuntu
Group=ubuntu
# Directory where the bot is installed on your Ubuntu server
WorkingDirectory=/opt/workout-bot
# Absolute paths to the venv Python and the main script
ExecStart=/opt/workout-bot/.venv/bin/python /opt/workout-bot/main.py

# Automatically restart if it crashes or the server reboots
Restart=always
RestartSec=5s

# Send output to journalctl and flush it immediately
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
