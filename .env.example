TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_USER_ID=your_telegram_numeric_id
TIMEZONE=Europe/Chisinau
WORKOUT_TIME=07:00

# Optional: outside alarm if the bot or server dies (free at https://healthchecks.io).
# Create a check with period 5 minutes / grace 15 minutes and paste its ping URL.
HEALTHCHECK_URL=

# Telegram Mini App. Needs a public https:// address (e.g. Caddy in front of
# 127.0.0.1:8080). Leave WEBAPP_URL empty to keep the app off.
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
WEBAPP_URL=
